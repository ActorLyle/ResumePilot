{
  "name": "resume-expert-ark-proxy",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.16.0 <21 || >=22.3.0"
  },
  "scripts": {
    "dev": "vite --configLoader runner",
    "server": "cross-env RESUME_PROXY_PORT=3002 node proxy-server.js",
    "proxy": "npm run server",
    "dev:all": "concurrently --kill-others --names PROXY,VITE \"npm:server\" \"npm:dev\"",
    "start": "npm run dev:all"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "vite": "^6.1.0"
  },
  "overrides": {
    "mammoth": {
      "argparse": "2.0.1"
    }
  }
}
